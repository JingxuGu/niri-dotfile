#!/usr/bin/env bash
# Run from the real desktop terminal; Codex's sandbox cannot use sudo/network.
set -euo pipefail
sudo apt install -y grim slurp wl-clipboard libgtk-4-1 libadwaita-1-0 libepoxy0 libfontconfig1
if command -v satty >/dev/null 2>&1 || [[ -x "$HOME/.local/bin/satty" ]]; then
    printf 'Satty is already installed.\n'
    exit 0
fi
[[ $(uname -m) == x86_64 ]] || { printf 'This installer is for x86_64.\n' >&2; exit 1; }
workdir=$(mktemp -d)
trap 'rm -rf -- "$workdir"' EXIT
curl --fail --location --retry 2 --output "$workdir/satty.tar.gz" \
    'https://github.com/Satty-org/Satty/releases/download/v0.22.0/satty-x86_64-unknown-linux-gnu.tar.gz'
printf '%s  %s\n' 'eb7a028c4a5ce331c2f355add8e2b807a7d697fe4495f7e1965786a4f6bcd5b8' "$workdir/satty.tar.gz" | sha256sum --check
tar -xzf "$workdir/satty.tar.gz" -C "$workdir"
binary=$(find "$workdir" -type f -name satty -print -quit)
[[ -n $binary ]] || { printf 'Satty executable not found in archive.\n' >&2; exit 1; }
mkdir -p "$HOME/.local/bin"
install -m 755 "$binary" "$HOME/.local/bin/satty"
"$HOME/.local/bin/satty" --version
printf 'Installed. Press Print to select and annotate a region.\n'

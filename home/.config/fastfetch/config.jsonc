// Pure ASCII Ubuntu logo; 32 columns / 15 rows compensate for terminal cell proportions.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/home/grainrain/.config/fastfetch/ubuntu-ascii.txt",
        "color": {
            "1": "38;2;233;84;32"
        },
        "padding": {
            "right": 3
        }
    },
    "display": {
        "separator": " > ",
        "color": {
            "keys": "38;2;180;190;254",
            "output": "39",
            "separator": "39",
            "title": "38;2;180;190;254"
        },
        "key": {
            "width": 13
        },
        "percent": {
            "type": 1
        }
    },
    "modules": [
        "title",
        "separator",
        {
            "type": "os",
            "key": "󰣇 OS      "
        },
        {
            "type": "kernel",
            "key": "󰌽 Kernel  "
        },
        {
            "type": "host",
            "key": "󰌢 Host    ",
            "format": "{vendor} {name}"
        },
        {
            "type": "uptime",
            "key": "󰔛 Uptime  "
        },
        {
            "type": "packages",
            "key": "󰏖 Packages"
        },
        {
            "type": "shell",
            "key": "󰆍 Shell   "
        },
        {
            "type": "terminal",
            "key": "󰆍 Terminal"
        },
        {
            "type": "wm",
            "key": "󰖲 WM      "
        },
        "break",
        {
            "type": "cpu",
            "key": "󰻠 CPU     "
        },
        {
            "type": "gpu",
            "key": "󰢮 GPU     "
        },
        {
            "type": "memory",
            "key": "󰍛 Memory  "
        }
    ]
}
